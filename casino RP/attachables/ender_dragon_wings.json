{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "cosmetics:ender_dragon_wings",
      "item": {
        "cosmetics:ender_dragon_wings": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/cosmetics/body/ender_dragon_wings",
        "enchanted": "textures/misc/enchanted_actor_glint"
      },
      "geometry": {
        "default": "geometry.ender_dragon_wings"
      },
      "scripts": {
        "animate": ["flap"],
        "parent_setup": "variable.chest_layer_visible = 0.0;"
      },
      "animations": {
        "flap": "animation.ender_dragon_wings.flap"
      },
      "render_controllers": [ "controller.render.armor" ]
    }
  }
}
