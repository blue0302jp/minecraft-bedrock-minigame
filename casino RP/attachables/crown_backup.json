{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "cosmetics:crown_backup",
      "item": {
        "cosmetics:crown": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/cosmetics/head/crown",
        "enchanted": "textures/misc/enchanted_actor_glint"
      },
      "geometry": {
        "default": "geometry.crown"
      },
      "scripts": {
        "parent_setup": "variable.helmet_layer_visible = 0.0;",
        "animate": ["rotate", "changeColor"]
      },
      "animations": {
        "rotate": "animation.crown.rotate",
        "changeColor": "animation.crown.changeColor"
      },
      "render_controllers": [ "controller.render.armor" ]
    }
  }
}
