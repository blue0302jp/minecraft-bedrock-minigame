{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "cosmetics:angel_ring",
      "item": {
        "cosmetics:angel_ring": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/cosmetics/head/angel_ring",
        "enchanted": "textures/misc/enchanted_actor_glint"
      },
      "geometry": {
        "default": "geometry.angel_ring"
      },
      "scripts": {
        "parent_setup": "variable.helmet_layer_visible = 0.0;"
      },
      "render_controllers": [ "controller.render.armor" ]
    }
  }
}
