{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.cosmetics_body" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{ "ender_dragon_wings": "query.property('cosmetics:body') == 1" }
					]
				},
				"ender_dragon_wings" : {
					"animations" : [ "ender_dradon_wings_flap"],
					"transitions" : [
						{ "default": "!(query.property('cosmetics:body') == 1)" }
					]
				}
			}
		}
	}
}
