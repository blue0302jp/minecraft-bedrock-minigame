{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.player.cape": {
      "rebuild_animation_matrices": true,
      "geometry": "Geometry.cape",
      "materials": [ { "*": "Material.cape" } ],
      "arrays": {
        "textures": {
          "array.skins": [
            "Texture.cape",
            "Texture.enderman_cape",
            "Texture.medival_torn_cape",
            "Texture.mcd_sinister_cape",
            "Texture.galaxy_cape"
          ]
        }
      },
      "textures" : [
        "array.skins[query.property('cosmetics:cape')]"
      ],
      "part_visibility": [
        { "cape": "query.armor_texture_slot(1) != 5 && (!variable.is_first_person || variable.is_paperdoll) && !variable.map_face_icon && !query.is_spectator && (query.property('cosmetics:body') == 0 || query.property('cosmetics:body') == 2)" }
      ],
      "is_hurt_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      }
    }
  }
}