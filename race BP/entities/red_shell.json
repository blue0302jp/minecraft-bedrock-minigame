{
    "format_version": "1.12.0",
    "minecraft:entity": {
      "description": {
        "identifier": "minerace:red_shell",
        "is_spawnable": false,
        "is_summonable": true,
        "is_experimental": false
      },
  
      "component_groups": {
        "minerace:move_shell" : {
          "minecraft:movement.amphibious": {
            "max_turn": 0
          },
          "minecraft:behavior.random_stroll": {
            "priority": 0,
            "interval": 0,       // 頻繁に新しい目標を探す (例: 20ティックごと)
            "speed_multiplier": 1.2, // 速度をさらに上げてみる
            "xz_dist": 1,        // 水平方向の探索距離を長くする
            "y_dist": 10          // 垂直方向の探索距離は維持
          },
          "minecraft:navigation.generic": {
            "can_path_from_air" : false
          },
          "minecraft:friction_modifier" : {
            "value" : 1
          }
        },
        "minerace:initial_movement_speed": {
          "minecraft:movement": { "value": 0.1} // ← ベース速度を上げる
        },
        "minerace:increased_movement_speed": {
          "minecraft:movement": { "value": 3} // ← ベース速度を上げる
        }
      },
  
      "components": {
        "minecraft:collision_box": {
          "width": 1.0,
          "height": 1.0
        },
        "minecraft:health": {
          "value": 1,
          "max": 1
        },
        "minecraft:fire_immune": {},
        "minecraft:physics": {
        },
        "minecraft:pushable": {
          "is_pushable": false,
          "is_pushable_by_piston": true
        },
        "minecraft:damage_sensor": {
          "triggers": {
            "cause": "fall",
            "deals_damage": false
          }
        },
        "minecraft:movement_sound_distance_offset" : {
          "value" : 99999999
        }
      },
  
      "events": {
        "minerace:move_shell": {
          "add": {
            "component_groups": ["minerace:move_shell", "minerace:initial_movement_speed"]
          }
        },
        "minerace:increase_movement_speed": {
          "remove": {
            "component_groups" : ["minerace:initial_movement_speed"]
          },
          "add": {
            "component_groups": ["minerace:increased_movement_speed"]
          }

        }
      }
  
    }
  }
  